# ============================================================
# Kotlin Multiplatform / Compose for Web – .gitignore
# ============================================================

# ----- Gradle build output ----------------------------------
**/build/
.gradle/

# Keep Gradle wrapper scripts (needed to build without a local install)
!gradlew
!gradlew.bat
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ----- Kotlin tooling cache ---------------------------------
.kotlin/

# ----- Kotlin/JS & Wasm npm artefacts -----------------------
# node_modules are always regenerated; yarn.lock IS committed
node_modules/
# Keep the yarn lockfile so builds are reproducible
!kotlin-js-store/**/yarn.lock

# ----- IDE – IntelliJ / Android Studio ----------------------
.idea/
*.iml

# Keep shared run configurations if you add any
!.idea/runConfigurations/

# ----- OS artefacts -----------------------------------------
.DS_Store
Thumbs.db

# ----- Android / Xcode leftovers (not used here but common) -
local.properties
captures/
.externalNativeBuild/
.cxx/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
xcuserdata/
